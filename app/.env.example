# ==========================
# Application
# ==========================
APP_NAME=Finance API
# development | production | test
APP_ENV=production
DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# ==========================
# PostgreSQL Database
# ==========================
DATABASE_URL=postgresql+psycopg://postgres:change_me@localhost:5432/finance_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ==========================
# JWT Configuration
# ==========================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================
# Redis (optional, dashboard cache)
# ==========================
REDIS_URL=redis://localhost:6379/0

# ==========================
# CORS - comma-separated allowed origins
# ==========================
CORS_ORIGINS=http://localhost:8080

# ==========================
# Email (HTTP API — preferred)
# ==========================
# Precedence: BREVO_API_KEY > RESEND_API_KEY > SMTP fallback.
# Set one API key and MAIL_FROM (a verified sender in that provider).
BREVO_API_KEY=
RESEND_API_KEY=
MAIL_FROM=

# Legacy SMTP fallback (only used when both API keys are empty)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
# STARTTLS on port 587, or set SSL_TLS=true + PORT=465 for SSL
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# ==========================
# Google OAuth
# ==========================
GOOGLE_CLIENT_ID=
