# Copy this file to `.env` and fill in real values before running `docker compose up`.
# docker compose automatically reads a `.env` file from the project root.

# REQUIRED: strong random secret for JWT signing.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=finance_db

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS - comma-separated origins that may call the API (e.g. your frontend domain)
CORS_ORIGINS=http://localhost:8080

# Google OAuth (optional)
GOOGLE_CLIENT_ID=

# SMTP (optional; registration/login emails use it)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# Published ports (optional overrides)
API_PORT=8000
FRONTEND_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
